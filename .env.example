# NairaMeme platform API
API_PORT=8790
API_HOST=127.0.0.1
APP_URL=nairameme://
ADMIN_API_TOKEN=
ADMIN_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nairameme
REDIS_URL=redis://localhost:6379

# Authentication and encrypted fields
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
FIELD_ENCRYPTION_KEY=
WEBHOOK_SIGNING_SECRET=
SECRET_MANAGER_PROVIDER=

# Admin portal build-time variables
VITE_API_URL=http://127.0.0.1:8790
EXPO_PUBLIC_API_URL=http://127.0.0.1:8790

# Identity: Supabase email/password first; phone OTP optional
AUTH_PROVIDER=supabase
AUTH_PROVIDER_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PHONE_OTP_ENABLED=false
TERMII_API_KEY=
SENDCHAMP_API_KEY=

# Naira payments: Monnify primary, Paystack and Flutterwave fallback
PAYMENT_PROVIDER=monnify
PAYMENT_PROVIDER_PUBLIC=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# KYC: one active provider at launch; adapters are admin-prioritized
KYC_PROVIDER=dojah
KYC_PROVIDER_SECRET=
DOJAH_APP_ID=
DOJAH_PRIVATE_KEY=

# Email, push, AI and trade execution
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_KEY=
EMAIL_FROM=NairaMeme <no-reply@example.com>
AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
EXPO_ACCESS_TOKEN=

# Emergent Universal LLM: rules-first and hard cost ceilings
EMERGENT_LLM_API_KEY=
EMERGENT_LLM_BASE_URL=
EMERGENT_LLM_MODEL=low-cost
AI_EXPLANATIONS_ENABLED=false
EMERGENT_LLM_DAILY_CREDIT_BUDGET=1
EMERGENT_LLM_MAX_REQUESTS_PER_MINUTE=6
EMERGENT_LLM_CACHE_TTL_SECONDS=900

# Market data and execution
PUMPPORTAL_API_KEY=
HELIUS_API_KEY=
BIRDEYE_API_KEY=
SOLANA_RPC_URL=
TRADING_PROVIDER_URL=
TRADING_PROVIDER_KEY=

# Production gates remain false until provider and compliance approval
FEATURE_DEPOSITS=false
FEATURE_WITHDRAWALS=false
FEATURE_TRADING=false
FEATURE_AUTO_SNIPER=false
FEATURE_COPY_TRADING=false

# Existing scanner engine
MODE=paper
DATA_MODE=hybrid
PORT=8787
CONFIG_PATH=config/default.json
HISTORY_PATH=data/history.jsonl
LIVE_TRADING_ENABLED=false
LIVE_DRY_RUN=true
LIVE_AUTO_TRADE_ENABLED=false
LIVE_TRADE_API_URL=
LIVE_TRADE_API_KEY=
