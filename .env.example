# MemeZo Platform - Environment Variables
# Copy this file to .env and fill in your values. Never commit .env.

# ─── API ──────────────────────────────────────────────────
API_PORT=8790
API_HOST=0.0.0.0
# Generate: openssl rand -hex 32
ADMIN_API_TOKEN=replace_with_secure_random_token
ADMIN_ORIGINS=http://localhost:5173

# ─── DATABASE ────────────────────────────────────────────
DATABASE_URL=postgresql://memezo:password@localhost:5432/memezo
REDIS_URL=redis://localhost:6379

# ─── AUTH ────────────────────────────────────────────────
# Generate: openssl rand -hex 48
JWT_SECRET=replace_with_secure_random_jwt_secret
JWT_EXPIRY=7d

# ─── MOBILE APP ──────────────────────────────────────────
# Local dev: http://127.0.0.1:8790  |  Production: https://api.memezo.ng
EXPO_PUBLIC_API_URL=http://127.0.0.1:8790

# ─── PAYMENT ─────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_replace
PAYSTACK_PUBLIC_KEY=pk_live_replace
FLUTTERWAVE_SECRET_KEY=FLWSECK-replace

# ─── CRYPTO / BLOCKCHAIN ─────────────────────────────────
HELIUS_API_KEY=replace
BIRDEYE_API_KEY=replace
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ─── KYC ─────────────────────────────────────────────────
SMILEID_PARTNER_ID=replace
SMILEID_API_KEY=replace

# ─── NOTIFICATIONS ───────────────────────────────────────
FCM_SERVER_KEY=replace

# ─── AI ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-replace
AI_DAILY_BUDGET_USD=5.00

# ─── WHATSAPP ────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=replace
WHATSAPP_ACCESS_TOKEN=replace
WHATSAPP_VERIFY_TOKEN=replace

# ─── MONITORING ──────────────────────────────────────────
SENTRY_DSN=https://replace@sentry.io/project

# ─── APP MODE ────────────────────────────────────────────
# WARNING: Only change to LIVE after all providers are tested
APP_DEFAULT_MODE=DEMO
