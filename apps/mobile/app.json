{
  "expo": {
    "name": "MemeZo",
    "slug": "memezo",
    "scheme": "memezo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ng.memezo.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to protect your MemeZo account and approve sensitive actions."
      }
    },
    "android": {
      "package": "ng.memezo.app",
      "adaptiveIcon": {
        "backgroundColor": "#07130F"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#19D38A"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07130F",
          "resizeMode": "contain"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "apiUrl": "http://127.0.0.1:8790"
    }
  }
}
