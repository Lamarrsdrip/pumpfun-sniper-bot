{
  "name": "nairameme-platform",
  "version": "0.2.0",
  "description": "Naira-first native meme trading platform with a controlled auto-sniper engine.",
  "type": "module",
  "private": true,
  "overrides": {
    "@expo/vector-icons": "15.0.3",
    "expo-font": "14.0.12",
    "react-native": "0.81.5"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node src/index.js",
    "scan": "node src/index.js scan",
    "simulate": "node src/index.js simulate data/sample-history.jsonl",
    "history": "node src/history-report.js",
    "test": "node --test test/*.test.js && npm test --workspace @nairameme/api",
    "mobile": "npm run start --workspace @nairameme/mobile",
    "mobile:ios": "npm run ios --workspace @nairameme/mobile",
    "mobile:android": "npm run android --workspace @nairameme/mobile",
    "api": "npm run dev --workspace @nairameme/api",
    "admin": "npm run dev --workspace @nairameme/admin",
    "admin:build": "npm run build --workspace @nairameme/admin",
    "api:typecheck": "npm run typecheck --workspace @nairameme/api",
    "mobile:typecheck": "npm run typecheck --workspace @nairameme/mobile",
    "platform:typecheck": "npm run api:typecheck && npm run mobile:typecheck"
  },
  "engines": {
    "node": ">=22"
  }
}
