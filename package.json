{
  "name": "nairameme-platform",
  "version": "0.2.0",
  "description": "MemeZo smart money platform for payments, crypto, meme intelligence, and controlled automation.",
  "type": "module",
  "private": true,
  "overrides": {
    "@expo/vector-icons": "15.0.3",
    "expo-font": "~14.0.12",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "devDependencies": {
    "@babel/helper-globals": "^7.29.7",
    "@babel/helper-string-parser": "^7.29.7",
    "@babel/helper-validator-identifier": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/plugin-proposal-export-default-from": "^7.29.7",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-syntax-export-default-from": "^7.29.7",
    "@babel/plugin-syntax-nullish-coalescing-operator": "^7.8.3",
    "@babel/plugin-syntax-optional-chaining": "^7.8.3",
    "@babel/plugin-transform-arrow-functions": "^7.29.7",
    "@babel/plugin-transform-async-generator-functions": "^7.29.7",
    "@babel/plugin-transform-async-to-generator": "^7.29.7",
    "@babel/plugin-transform-block-scoping": "^7.29.7",
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@babel/plugin-transform-class-static-block": "^7.29.7",
    "@babel/plugin-transform-classes": "^7.29.7",
    "@babel/plugin-transform-destructuring": "^7.29.7",
    "@babel/plugin-transform-export-namespace-from": "^7.29.7",
    "@babel/plugin-transform-flow-strip-types": "^7.29.7",
    "@babel/plugin-transform-for-of": "^7.29.7",
    "@babel/plugin-transform-logical-assignment-operators": "^7.29.7",
    "@babel/plugin-transform-named-capturing-groups-regex": "^7.29.7",
    "@babel/plugin-transform-nullish-coalescing-operator": "^7.29.7",
    "@babel/plugin-transform-object-rest-spread": "^7.29.7",
    "@babel/plugin-transform-optional-catch-binding": "^7.29.7",
    "@babel/plugin-transform-optional-chaining": "^7.29.7",
    "@babel/plugin-transform-parameters": "^7.29.7",
    "@babel/plugin-transform-private-methods": "^7.29.7",
    "@babel/plugin-transform-private-property-in-object": "^7.29.7",
    "@babel/plugin-transform-react-display-name": "^7.29.7",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@babel/plugin-transform-react-jsx-development": "^7.29.7",
    "@babel/plugin-transform-react-pure-annotations": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/plugin-transform-shorthand-properties": "^7.29.7",
    "@babel/plugin-transform-template-literals": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.7",
    "@babel/plugin-transform-unicode-regex": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@react-native/babel-plugin-codegen": "^0.85.3",
    "@rollup/rollup-darwin-x64": "^4.61.1",
    "@types/react": "19.2.14",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "babel-plugin-transform-flow-enums": "^0.0.2",
    "esbuild": "0.28.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "scan": "node src/index.js scan",
    "simulate": "node src/index.js simulate data/sample-history.jsonl",
    "history": "node src/history-report.js",
    "test": "node --test test/*.test.js && npm test --workspace @nairameme/api",
    "mobile": "npm run start --workspace @nairameme/mobile",
    "mobile:ios": "npm run ios --workspace @nairameme/mobile",
    "mobile:android": "npm run android --workspace @nairameme/mobile",
    "api": "npm run dev --workspace @nairameme/api",
    "admin": "npm run dev --workspace @nairameme/admin",
    "admin:build": "npm run build --workspace @nairameme/admin",
    "api:typecheck": "npm run typecheck --workspace @nairameme/api",
    "mobile:typecheck": "npm run typecheck --workspace @nairameme/mobile",
    "platform:typecheck": "npm run api:typecheck && npm run mobile:typecheck"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@egjs/hammerjs": "^2.0.17",
    "@expo-google-fonts/material-symbols": "^0.4.38",
    "@fastify/ajv-compiler": "^4.0.5",
    "@fastify/fast-json-stringify-compiler": "^5.0.3",
    "@fastify/proxy-addr": "^5.1.0",
    "abstract-logging": "^2.0.1",
    "avvio": "^9.2.0",
    "find-my-way": "^9.6.0",
    "hoist-non-react-statics": "^3.3.2",
    "invariant": "^2.2.4",
    "light-my-request": "^6.6.0",
    "process-warning": "^5.0.0",
    "react-freeze": "^1.0.4",
    "react-native-is-edge-to-edge": "^1.3.1",
    "rfdc": "^1.4.1",
    "secure-json-parse": "^4.1.0",
    "warn-once": "^0.1.1"
  }
}
